{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void-vault.local/schemas/evidence/env.schema.json",
  "title": "Void Vault Environment Descriptor Schema",
  "description": "Standardized environmental recording for reproducibility (OS, VM specs, hardware, tool versions).",
  "type": "object",
  "required": [
    "os",
    "host_hardware",
    "vm_specs",
    "tool_versions",
    "build"
  ],
  "properties": {
    "os": {
      "type": "object",
      "required": ["name", "build", "architecture"],
      "properties": {
        "name": { "type": "string" },
        "build": { "type": "string" },
        "architecture": { "type": "string" }
      }
    },
    "host_hardware": {
      "type": "object",
      "required": ["cpu", "ram_gb", "storage_type"],
      "properties": {
        "cpu": { "type": "string" },
        "ram_gb": { "type": "number" },
        "storage_type": { "type": "string" }
      }
    },
    "vm_specs": {
      "type": "object",
      "required": ["hypervisor", "vcpu", "vram_mb", "disk_type"],
      "properties": {
        "hypervisor": { "type": "string" },
        "vcpu": { "type": "integer" },
        "vram_mb": { "type": "integer" },
        "disk_type": { "type": "string" }
      }
    },
    "tool_versions": {
      "type": "object",
      "required": ["rustc", "cargo", "python"],
      "properties": {
        "rustc": { "type": "string" },
        "cargo": { "type": "string" },
        "python": { "type": "string" },
        "photorec": { "type": "string" },
        "scalpel": { "type": "string" },
        "foremost": { "type": "string" },
        "sleuthkit": { "type": "string" }
      }
    },
    "build": {
      "type": "object",
      "required": ["tag", "commit", "binary_sha256"],
      "properties": {
        "tag": { "type": "string" },
        "commit": { "type": "string" },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
