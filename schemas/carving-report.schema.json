{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nishchaydev.github.io/Void-Vault/schemas/carving-report.schema.json",
  "title": "Void Vault Carving Report",
  "description": "Report generated by Module 3 (Advanced File Carving and Recovery) after scanning a target device or image.",
  "type": "object",
  "required": ["report_id", "timestamp", "target", "scan_config", "summary", "artifacts"],
  "properties": {
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "build": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["type", "size_bytes"],
      "properties": {
        "type": { "type": "string", "enum": ["physical_device", "disk_image", "partition", "directory"] },
        "path_or_serial": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "filesystem": { "type": "string" }
      }
    },
    "scan_config": {
      "type": "object",
      "properties": {
        "engines_enabled": {
          "type": "array",
          "items": { "type": "string", "enum": ["signature", "bgc", "bfd"] },
          "description": "Which carving engines were active."
        },
        "sector_size": { "type": "integer", "default": 512 },
        "max_file_size_bytes": { "type": "integer" },
        "file_types_targeted": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of file type signatures searched for."
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["sectors_scanned", "artifacts_found", "duration_seconds"],
      "properties": {
        "sectors_scanned": { "type": "integer", "minimum": 0 },
        "sectors_total": { "type": "integer", "minimum": 0 },
        "artifacts_found": { "type": "integer", "minimum": 0 },
        "artifacts_by_class": {
          "type": "object",
          "description": "Count per classification class.",
          "properties": {
            "Document": { "type": "integer" },
            "Image": { "type": "integer" },
            "Audio": { "type": "integer" },
            "Video": { "type": "integer" },
            "Archive": { "type": "integer" },
            "Executable": { "type": "integer" },
            "Web": { "type": "integer" },
            "Database": { "type": "integer" },
            "Unknown": { "type": "integer" }
          }
        },
        "mean_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "throughput_mbps": { "type": "number", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "file_type", "classification", "confidence", "offset_bytes", "size_bytes"],
        "properties": {
          "artifact_id": { "type": "string", "format": "uuid" },
          "file_type": { "type": "string", "description": "Detected file type (e.g., JPEG, PDF, DOCX)." },
          "classification": {
            "type": "string",
            "enum": ["Document", "Image", "Audio", "Video", "Archive", "Executable", "Web", "Database", "Unknown"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence_breakdown": {
            "type": "object",
            "properties": {
              "signature_score": { "type": "number" },
              "structural_score": { "type": "number" },
              "bfd_score": { "type": "number" }
            }
          },
          "offset_bytes": { "type": "integer", "minimum": 0 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "fragmented": { "type": "boolean" },
          "fragment_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "chain": {
      "type": "object",
      "properties": {
        "entry_hash": { "type": "string" },
        "ledger_index": { "type": "integer" }
      },
      "description": "Link to the audit ledger entry for this carving operation."
    }
  }
}
