{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nishchaydev.github.io/Void-Vault/schemas/certificate.schema.json",
  "title": "Void Vault Erasure Certificate",
  "description": "BSA 2023 s.63(4) Schedule-format certificate generated by Void Vault after verified data sanitization.",
  "type": "object",
  "required": ["certificate_id", "version", "generated_at", "build", "device", "sanitization", "verification", "chain"],
  "properties": {
    "certificate_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique certificate identifier (UUIDv4)."
    },
    "version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of certificate generation."
    },
    "build": {
      "type": "object",
      "required": ["version", "commit", "binary_hash"],
      "properties": {
        "version": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "binary_hash": { "type": "string", "description": "SHA-256 of the Void Vault binary." }
      }
    },
    "device": {
      "type": "object",
      "required": ["serial", "model", "interface", "capacity_bytes"],
      "properties": {
        "serial": { "type": "string", "description": "Drive serial number." },
        "model": { "type": "string" },
        "manufacturer": { "type": "string" },
        "interface": { "type": "string", "enum": ["NVMe", "SATA", "USB", "SD", "eMMC"] },
        "capacity_bytes": { "type": "integer", "minimum": 0 },
        "firmware": { "type": "string" }
      }
    },
    "sanitization": {
      "type": "object",
      "required": ["standard", "nist_level", "passes", "started_at", "completed_at", "duration_seconds"],
      "properties": {
        "standard": { "type": "string", "description": "Name of the sanitization standard applied." },
        "nist_level": { "type": "string", "enum": ["Clear", "Purge"], "description": "NIST SP 800-88 Rev. 2 sanitization level achieved." },
        "ieee_category": { "type": "string" },
        "passes": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "method_notes": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["method", "result", "sectors_verified"],
      "properties": {
        "method": { "type": "string", "enum": ["full_readback", "stratified_sampling", "none"] },
        "result": { "type": "string", "enum": ["pass", "fail", "partial"] },
        "sectors_verified": { "type": "integer", "minimum": 0 },
        "sectors_total": { "type": "integer", "minimum": 0 },
        "confidence_level": { "type": "number", "minimum": 0, "maximum": 1 },
        "hash_algorithm": { "type": "string", "const": "SHA-256" },
        "post_wipe_hash": { "type": "string", "description": "SHA-256 of the entire drive content after sanitization." },
        "entropy_score": { "type": "number", "minimum": 0, "maximum": 8 }
      }
    },
    "chain": {
      "type": "object",
      "required": ["entry_hash", "prev_hash", "ledger_index"],
      "properties": {
        "entry_hash": { "type": "string", "description": "SHA-256(entry || prev_hash)" },
        "prev_hash": { "type": "string" },
        "ledger_index": { "type": "integer", "minimum": 0 },
        "merkle_root": { "type": "string" },
        "session_id": { "type": "string", "format": "uuid" }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "case_number": { "type": "string" }
      }
    },
    "bsa63": {
      "type": "object",
      "description": "BSA 2023 s.63(4) Schedule mapping.",
      "properties": {
        "part_a": { "type": "object", "description": "Custodian's certificate fields." },
        "part_b": { "type": "object", "description": "Technical examiner's certificate fields." },
        "signed": { "type": "boolean", "default": false, "description": "Whether DSC/eSign has been applied." }
      }
    }
  }
}
